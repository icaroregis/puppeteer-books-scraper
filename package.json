{
  "name": "puppeteer-books-scraper",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "dev:debug": "node --inspect-brk --import tsx src/index.ts",
    "dev:logs": "DEBUG=puppeteer:* tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:logs": "DEBUG=puppeteer:* node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build"
  },
  "keywords": [],
  "author": "Ícaro Almeida",
  "license": "ISC",
  "packageManager": "pnpm@10.29.2",
  "dependencies": {
    "puppeteer": "^25.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer",
      "esbuild"
    ]
  }
}
